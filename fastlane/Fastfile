default_platform(:ios)

platform :ios do
  desc "Build signed IPA and upload to TestFlight (GitHub Actions)"
  lane :github_testflight do
    marketing_version = ENV["MARKETING_VERSION"] || ENV["APP_VERSION"] || "1.0.0"
    build_number = ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || "1"

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    build_app(
      project: "ios/SynapsNotes-iOS.xcodeproj",
      scheme: "SynapsNotes-iOS",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      skip_profile_detection: true,
      codesigning_identity: "Apple Distribution",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch("APPLE_TEAM_ID")} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" PROVISIONING_PROFILE_SPECIFIER=\"#{ENV.fetch("PROFILE_NAME")}\" MARKETING_VERSION=#{marketing_version} CURRENT_PROJECT_VERSION=#{build_number} INFOPLIST_KEY_CFBundleShortVersionString=#{marketing_version} INFOPLIST_KEY_CFBundleVersion=#{build_number}",
      output_directory: "build",
      output_name: "SynapsNotes-iOS.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          ENV.fetch("APP_IDENTIFIER") => ENV.fetch("PROFILE_NAME")
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      ipa: "build/SynapsNotes-iOS.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
