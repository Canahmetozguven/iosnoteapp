default_platform(:ios)

platform :ios do
  desc "Build signed IPA (GitHub Actions)"
  lane :github_build do
    marketing_version = ENV["MARKETING_VERSION"] || ENV["APP_VERSION"] || "1.0.0"
    build_number = ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || "1"

    build_app(
      project: "ios/SynapsNotes-iOS.xcodeproj",
      scheme: "SynapsNotes-iOS",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      skip_profile_detection: true,
      # Important: don't pass PROVISIONING_PROFILE_SPECIFIER / manual signing to xcodebuild.
      # Swift Package targets (GoogleSignIn, Promises, ZIPFoundation, ...) are not signable with profiles.
      # We archive unsigned, then sign at export time via export_options.provisioningProfiles.
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO MARKETING_VERSION=#{marketing_version} CURRENT_PROJECT_VERSION=#{build_number} INFOPLIST_FILE=Resources/Info.plist GENERATE_INFOPLIST_FILE=NO ASSETCATALOG_COMPILER_APPICON_NAME=AppIcon",
      output_directory: "build",
      output_name: "SynapsNotes-iOS.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          ENV.fetch("APP_IDENTIFIER") => ENV.fetch("PROFILE_NAME")
        }
      }
    )
  end

  desc "Upload existing IPA to TestFlight (GitHub Actions)"
  lane :github_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      ipa: "build/SynapsNotes-iOS.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build signed IPA and upload to TestFlight (GitHub Actions)"
  lane :github_testflight do
    github_build
    github_upload
  end
end
